[Unit]
Description=TrialBench classification benchmark (resumable)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=__REPO_DIR__
# Optional secrets/config (e.g. TABPFN_TOKEN) that shouldn't live in git --
# the leading "-" means systemd won't fail if this file doesn't exist yet.
# Create it with lines like `TABPFN_TOKEN=<key>`, then `systemctl restart`.
EnvironmentFile=-__REPO_DIR__/.env
ExecStart=__REPO_DIR__/deploy/run_forever.sh
Restart=on-failure
RestartSec=30
# run_forever.sh already retries internally with backoff; this Restart= is the
# outer safety net for the case systemd itself decided to stop the unit (e.g.
# OOM-killed hard enough that even the flock/lockfile cleanup didn't happen)
# or, most importantly, for a full instance reboot: `enable` below makes this
# unit start on boot, which is what actually resumes the run after a
# spot-interruption + relaunch or a maintenance reboot.
StandardOutput=append:__REPO_DIR__/logs/systemd.log
StandardError=append:__REPO_DIR__/logs/systemd.log

[Install]
WantedBy=multi-user.target
